{
  "name": "@repo/gallery",
  "version": "0.0.0",
  "private": true,
  "description": "Private dogfood gallery: Radix docs demos ported to Solid 2 + Solidix. Never published. Verification harness, not a product surface.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5193 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5194 --strictPort",
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/themes": "3.3.0",
