{
  "name": "@repo/smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Private pipeline-validation package. Never published. Proves build/typecheck/lint/test work for a Solid 2 component.",
  "license": "MIT",
  "source": "./src/index.ts",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "soldix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3"
  }
}
