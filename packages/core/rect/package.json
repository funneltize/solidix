{
  "name": "@solidix/rect",
  "version": "0.0.0",
  "description": "Rect observation utilities (port of @radix-ui/rect).",
  "homepage": "https://github.com/funneltize/solidix",
  "bugs": {
    "url": "https://github.com/funneltize/solidix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/solidix.git",
    "directory": "packages/core/rect"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "solidix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  }
}
