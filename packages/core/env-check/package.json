{
  "name": "@solidix/env-check",
  "version": "0.1.0",
  "description": "Environment checks shared by solidix packages (port of @radix-ui/env-check).",
  "homepage": "https://github.com/funneltize/solidix",
  "bugs": {
    "url": "https://github.com/funneltize/solidix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/solidix.git",
    "directory": "packages/core/env-check"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./is-development": "./src/internal/is-development.true.ts"
  },
  "publishConfig": {
    "exports": {
      "./is-development": {
        "development": {
          "import": {
            "types": "./dist/internal/is-development.true.d.ts",
            "default": "./dist/internal/is-development.true.mjs"
          },
          "require": {
            "types": "./dist/internal/is-development.true.d.ts",
            "default": "./dist/internal/is-development.true.js"
          }
        },
        "production": {
          "import": {
            "types": "./dist/internal/is-development.false.d.ts",
            "default": "./dist/internal/is-development.false.mjs"
          },
          "require": {
            "types": "./dist/internal/is-development.false.d.ts",
            "default": "./dist/internal/is-development.false.js"
          }
        },
        "default": {
          "import": {
            "types": "./dist/internal/is-development.false.d.ts",
            "default": "./dist/internal/is-development.false.mjs"
          },
          "require": {
            "types": "./dist/internal/is-development.false.d.ts",
            "default": "./dist/internal/is-development.false.js"
          }
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "solidix-build src/internal/is-development.true.ts internal/is-development.true && solidix-build src/internal/is-development.false.ts internal/is-development.false --no-empty && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  }
}
