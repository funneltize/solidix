{
  "name": "soldix",
  "version": "0.0.0",
  "description": "Umbrella package re-exporting all Soldix primitives (port of radix-ui).",
  "homepage": "https://github.com/funneltize/soldix",
  "bugs": {
    "url": "https://github.com/funneltize/soldix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/soldix.git",
    "directory": "packages/solid/soldix"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "soldix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@soldix/accordion": "workspace:*",
    "@soldix/alert-dialog": "workspace:*",
    "@soldix/aspect-ratio": "workspace:*",
    "@soldix/avatar": "workspace:*",
    "@soldix/checkbox": "workspace:*",
    "@soldix/collapsible": "workspace:*",
    "@soldix/context-menu": "workspace:*",
    "@soldix/dialog": "workspace:*",
    "@soldix/dropdown-menu": "workspace:*",
    "@soldix/form": "workspace:*",
    "@soldix/hover-card": "workspace:*",
    "@soldix/label": "workspace:*",
    "@soldix/menubar": "workspace:*",
    "@soldix/navigation-menu": "workspace:*",
    "@soldix/one-time-password-field": "workspace:*",
    "@soldix/password-toggle-field": "workspace:*",
    "@soldix/popover": "workspace:*",
    "@soldix/progress": "workspace:*",
    "@soldix/radio-group": "workspace:*",
    "@soldix/scroll-area": "workspace:*",
    "@soldix/select": "workspace:*",
    "@soldix/separator": "workspace:*",
    "@soldix/slider": "workspace:*",
    "@soldix/switch": "workspace:*",
    "@soldix/tabs": "workspace:*",
    "@soldix/toast": "workspace:*",
    "@soldix/toggle": "workspace:*",
    "@soldix/toggle-group": "workspace:*",
    "@soldix/toolbar": "workspace:*",
    "@soldix/tooltip": "workspace:*"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@solidjs/web": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.15 <2.1.0",
    "solid-js": ">=2.0.0-rc.15 <2.1.0"
  }
}
