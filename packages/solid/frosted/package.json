{
  "name": "@solidix/frosted",
  "version": "0.2.0",
  "description": "Solid port of frosted-ui: styled, themeable components built on @solidix/* primitives.",
  "homepage": "https://github.com/funneltize/solidix",
  "bugs": {
    "url": "https://github.com/funneltize/solidix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/solidix.git",
    "directory": "packages/solid/frosted"
  },
  "source": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./styles.lite.css": "./src/styles.lite.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "solidix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "gen:css": "node scripts/build-css.mjs"
  },
  "dependencies": {
    "@solidix/accordion": "workspace:*",
    "@solidix/alert-dialog": "workspace:*",
    "@solidix/avatar": "workspace:*",
    "@solidix/checkbox": "workspace:*",
    "@solidix/compose-refs": "workspace:*",
    "@solidix/context-menu": "workspace:*",
    "@solidix/dialog": "workspace:*",
    "@solidix/direction": "workspace:*",
    "@solidix/dropdown-menu": "workspace:*",
    "@solidix/form": "workspace:*",
    "@solidix/hover-card": "workspace:*",
    "@solidix/id": "workspace:*",
    "@solidix/label": "workspace:*",
    "@solidix/navigation-menu": "workspace:*",
    "@solidix/one-time-password-field": "workspace:*",
    "@solidix/popover": "workspace:*",
    "@solidix/primitive": "workspace:*",
    "@solidix/progress": "workspace:*",
    "@solidix/radio-group": "workspace:*",
    "@solidix/scroll-area": "workspace:*",
    "@solidix/select": "workspace:*",
    "@solidix/separator": "workspace:*",
    "@solidix/slider": "workspace:*",
    "@solidix/slot": "workspace:*",
    "@solidix/switch": "workspace:*",
    "@solidix/tabs": "workspace:*",
    "@solidix/tooltip": "workspace:*",
    "@solidix/use-controllable-state": "workspace:*",
    "@solidix/visually-hidden": "workspace:*",
    "credit-card-type": "10.1.2"
  },
  "devDependencies": {
    "@frosted-ui/colors": "0.0.1-canary.162",
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/web": "2.0.0-rc.18",
    "@testing-library/user-event": "14.6.8",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "postcss-combine-duplicated-selectors": "10.0.3",
    "postcss-custom-media": "10.0.8",
    "postcss-discard-empty": "6.0.3",
    "postcss-import": "15.1.0",
    "postcss-nesting": "12.1.5",
    "solid-js": "2.0.0-rc.18"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.18 <2.1.0",
    "solid-js": ">=2.0.0-rc.18 <2.1.0"
  }
}
