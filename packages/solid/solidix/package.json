{
  "name": "solidix",
  "version": "0.1.0",
  "description": "Umbrella package re-exporting all Solidix primitives (port of radix-ui).",
  "homepage": "https://github.com/funneltize/solidix",
  "bugs": {
    "url": "https://github.com/funneltize/solidix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/solidix.git",
    "directory": "packages/solid/solidix"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "solidix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solidix/accordion": "workspace:*",
    "@solidix/alert-dialog": "workspace:*",
    "@solidix/aspect-ratio": "workspace:*",
    "@solidix/avatar": "workspace:*",
    "@solidix/checkbox": "workspace:*",
    "@solidix/collapsible": "workspace:*",
    "@solidix/context-menu": "workspace:*",
    "@solidix/dialog": "workspace:*",
    "@solidix/dropdown-menu": "workspace:*",
    "@solidix/form": "workspace:*",
    "@solidix/funnel": "workspace:*",
    "@solidix/hover-card": "workspace:*",
    "@solidix/label": "workspace:*",
    "@solidix/menubar": "workspace:*",
    "@solidix/navigation-menu": "workspace:*",
    "@solidix/one-time-password-field": "workspace:*",
    "@solidix/password-toggle-field": "workspace:*",
    "@solidix/popover": "workspace:*",
    "@solidix/progress": "workspace:*",
    "@solidix/radio-group": "workspace:*",
    "@solidix/scroll-area": "workspace:*",
    "@solidix/select": "workspace:*",
    "@solidix/separator": "workspace:*",
    "@solidix/slider": "workspace:*",
    "@solidix/switch": "workspace:*",
    "@solidix/tabs": "workspace:*",
    "@solidix/toast": "workspace:*",
    "@solidix/toggle": "workspace:*",
    "@solidix/toggle-group": "workspace:*",
    "@solidix/toolbar": "workspace:*",
    "@solidix/tooltip": "workspace:*"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@solidjs/web": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.15 <2.1.0",
    "solid-js": ">=2.0.0-rc.15 <2.1.0"
  }
}
