{
  "name": "@solidix/funnel",
  "version": "0.1.0",
  "description": "Design language for direct-response landing pages: design tokens plus themed funnel blocks built on Solidix primitives.",
  "homepage": "https://github.com/funneltize/solidix",
  "bugs": {
    "url": "https://github.com/funneltize/solidix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funneltize/solidix.git",
    "directory": "packages/solid/funnel"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "PHILOSOPHY.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./blocks.css": "./src/blocks.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./tokens.css": "./src/tokens.css",
      "./blocks.css": "./src/blocks.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "solidix-build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "gen:tokens": "node scripts/gen-tokens.mjs"
  },
  "dependencies": {
    "@solidix/accordion": "workspace:*",
    "@solidix/aspect-ratio": "workspace:*",
    "@solidix/dialog": "workspace:*",
    "@solidix/form": "workspace:*",
    "@solidix/primitive": "workspace:*",
    "@solidix/radio-group": "workspace:*"
  },
  "devDependencies": {
    "@repo/builder": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/web": "2.0.0-rc.15",
    "@testing-library/user-event": "14.6.8",
    "solid-js": "2.0.0-rc.15"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.15 <2.1.0",
    "solid-js": ">=2.0.0-rc.15 <2.1.0"
  }
}
