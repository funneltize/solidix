{
  "name": "soldix",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**/*\" run build",
    "typecheck": "pnpm -r --parallel --no-bail run typecheck",
    "lint": "pnpm -r --no-bail run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.5.0"
}
